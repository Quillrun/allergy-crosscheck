{
  "name": "allergy-crosscheck",
  "version": "0.1.0",
  "description": "Allergy Crosscheck: a fail-closed allergy checker for Alexa+ (MCP server + MCP Apps screen)",
  "scripts": {
    "start": "node --experimental-strip-types --no-warnings=ExperimentalWarning src/server/main.ts",
    "test": "node --experimental-strip-types --no-warnings=ExperimentalWarning --test \"test/*.test.ts\" \"packages/allergen-guard/test/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "barcode-detector": "^3.2.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  },
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Quillrun/allergy-crosscheck"
  },
  "keywords": [
    "alexa",
    "mcp",
    "allergens",
    "food-allergy",
    "open-food-facts"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.6"
  }
}
